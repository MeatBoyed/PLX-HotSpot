# ─────────────────────────────────────────────────────────────────────────────
# LAYERED ENV — 3 files, copied from these .example templates (real .env* are
# git-ignored). They STACK, they are not alternatives:
#
#   .env          shared base   — port map + Postgres creds (Compose reads it)
#   .env.current  current group — clients/current/* (admin, captive, monitor)
#   .env.legacy   legacy group  — legacy monolith + DATABASE_URL             ← THIS FILE
#
# Load order: `dotenv -e .env.legacy -e .env` → THIS file wins on conflicts,
# root .env fills the gaps (e.g. the port map). Rationale: ADR 0004.
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE (.env.legacy): copy to `.env.legacy`. App config for the legacy
# monolith (@auraconnect/captive-portal-and-admin-legacy). The key value this slice
# adds over the app's own .env.example is DATABASE_URL, pointing at the legacy DB
# from dev/init/20-legacy-db.sql — supplying it unblocks the env-gated legacy build.

###############################################
# Database (legacy Prisma monolith)
###############################################
# Host-side URL: Postgres is published on the mapped host port 5442.
DATABASE_URL="postgresql://legacy:legacy_pw@localhost:5442/phs_portal?connect_timeout=30"

###############################################
# Core Application / Branding
###############################################
USE_SEED_DATA=true
SITE_TITLE="PluxNet Fibre HotSpot"
SITE_DESCRIPTION=PluxNet Fibre HotSpot
BRAND_NAME=PluxNet

###############################################
# Network / SSID
###############################################
NEXT_PUBLIC_SSID=my-demo-ssid
SSID=my-demo-ssid

###############################################
# MikroTik / RadiusDesk Essentials
###############################################
NEXT_PUBLIC_MIKROTIK_DEFAULT_USERNAME=click_to_connect@dev
NEXT_PUBLIC_MIKROTIK_DEFAULT_PASSWORD=click_to_connect
MIKROTIK_RADIUS_DESK_BASE_URL=https://radiusdesk.pluxnet.co.za
MIKROTIK_REDIRECT_URL=https://pluxnet.co.za
NEXT_PUBLIC_MIKROTIK_BASE_URL=https://gateway.pluxnet.co.za

###############################################
# PayFast (Purchasing) — sandbox
###############################################
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_TEST_MSISDN=

###############################################
# Voucher / RadiusDesk API (server)
###############################################
VOUCHER_DEFAULT_TTL_HOURS=24
RADIUSDESK_TOKEN=
RADIUSDESK_REALM_ID=
RADIUSDESK_PROFILE_ID=
RADIUSDESK_CLOUD_ID=

###############################################
# SMS Services (stub unless set)
###############################################
SMS_API_URL=
SMS_API_KEY=
# EC1_SMS_API_URL is url-validated (zod .url().optional()) — leave UNSET, not empty,
# or the build rejects "" as an invalid URL. Uncomment with a real URL to enable.
# EC1_SMS_API_URL=https://notification-engine.ec1.co.za
EC1_SMS_USER_ID=
EC1_SMS_PASSWORD=

###############################################
# Analytics / Auth
###############################################
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# ClerkProvider requires a well-formed publishable key at build/prerender (the root
# layout wraps every page). This is Clerk's documented dummy key (decodes to
# clerk.example.com$) — no network for a static build. Replace with a real dev key to
# exercise auth flows.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=
