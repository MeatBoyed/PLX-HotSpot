# ─────────────────────────────────────────────────────────────────────────────
# LAYERED ENV — 3 files, copied from these .example templates (real .env* are
# git-ignored). They STACK, they are not alternatives:
#
#   .env          shared base   — port map + Postgres creds. Docker Compose
#                                 auto-loads it, and it underlays both groups.
#   .env.current  current group — clients/current/* (admin, captive, monitor)
#   .env.legacy   legacy group  — legacy monolith + DATABASE_URL
#
# Load order per client: `dotenv -e .env.<group> -e .env` → the GROUP file wins on
# conflicts, root .env fills the gaps. Rationale: ADR 0004.
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE (.env): the shared base. Copy to `.env`. Compose reads it directly;
# both groups layer on top of it. Keep only things shared by infra + both groups.

# ── Central port map (host ports; see docs slice 2026-07-01--02) ──────────────
POSTGRES_HOST_PORT=5442
PGADMIN_HOST_PORT=5050
SEQ_HOST_PORT=5342
API_HOST_PORT=5299
# Client dev servers (host, via concurrently)
ADMIN_PORT=3301
CAPTIVE_PORTAL_PORT=3302
MONITOR_PORT=3303
LEGACY_PORT=3401

# ── Postgres bootstrap (superuser + neutral bootstrap DB) ─────────────────────
# App databases (auraconnect, phs_portal) + their roles are created by dev/init/*.
POSTGRES_USER=local_dev
POSTGRES_PASSWORD=local_dev_pw
POSTGRES_DB=postgres

# ── API ──────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
