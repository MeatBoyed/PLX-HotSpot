###############################################
# Core Application / Branding
###############################################
USE_SEED_DATA=true
SITE_TITLE="PluxNet Fibre HotSpot"
SITE_DESCRIPTION=PluxNet Fibre HotSpot
BRAND_NAME=PluxNet

###############################################
# Network / SSID
###############################################
# Public SSID exposed to clients
# NEXT_PUBLIC_SSID="Jozi-wifi"
# NEXT_PUBLIC_SSID="PluxNet-Free-WiFi"
NEXT_PUBLIC_SSID=my-demo-ssid
# Server-side SSID reference (plan catalog). Keep in sync with NEXT_PUBLIC_SSID.
SSID=my-demo-ssid

###############################################
# Hotspot API (Images / Config)
###############################################
# Deprecated: Frontend image URLs now use the internal /api/image/:slug?ssid=... route via imageUrl().
# Leaving this here for backward compatibility with older builds only.
# NEXT_PUBLIC_HOTSPOT_API_BASE_URL="http://localhost:3000/api/portal/config/image"
# NEXT_PUBLIC_HOTSPOT_API_BASE_URL="https://hotspot.pluxnet.co.za/api/portal/config/image"

###############################################
# MikroTik / RadiusDesk Essentials
###############################################
NEXT_PUBLIC_MIKROTIK_DEFAULT_USERNAME=click_to_connect@dev
NEXT_PUBLIC_MIKROTIK_DEFAULT_PASSWORD=click_to_connect
MIKROTIK_RADIUS_DESK_BASE_URL=https://radiusdesk.pluxnet.co.za
MIKROTIK_REDIRECT_URL=https://pluxnet.co.za
NEXT_PUBLIC_MIKROTIK_BASE_URL=https://gateway.pluxnet.co.za

###############################################
# PayFast (Purchasing)
###############################################
# Modes: sandbox | live (default sandbox if unset)
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# REQUIRED for signature creation/verification
PAYFAST_PASSPHRASE= 
# Optional override for MSISDN used in checkout form (falls back to 27820000000)
PAYFAST_TEST_MSISDN= 

###############################################
# Voucher Settings
###############################################
VOUCHER_DEFAULT_TTL_HOURS=24

###############################################
# RadiusDesk Voucher API (Server)
###############################################
# Base URL shared with MikroTik section above
# MIKROTIK_RADIUS_DESK_BASE_URL="https://radiusdesk.pluxnet.co.za"
# API token and identifiers required to create vouchers
RADIUSDESK_TOKEN=
RADIUSDESK_REALM_ID=
RADIUSDESK_PROFILE_ID=
RADIUSDESK_CLOUD_ID=

###############################################
# SMS Service (Stub / External Gateway)
###############################################
# If SMS_API_URL is unset, service logs dry-run only - e.g. https://sms.connect-mobile.co.za/submit/single/
SMS_API_URL=
# Bearer token (if required by provider)
SMS_API_KEY= 

###############################################
# EC1 SMS Service (External Gateway)
###############################################
# EC1_SMS_API_URL is validated as a URL (src/env.ts). Leave it COMMENTED OUT
# when unused — an empty value fails url() validation and breaks the build.
# Uncomment and set a real URL to enable the EC1 SMS gateway.
# EC1_SMS_API_URL=https://sms.example.com/submit
EC1_SMS_USER_ID=
EC1_SMS_PASSWORD=

###############################################
# Misc / Future
###############################################
# (Add additional service env vars below)

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

###############################################
# Clerk (Authentication)
###############################################
# Placeholder DEV keys so `npm run build` can prerender the admin pages on a bare
# clone. These are INERT — admin auth will NOT actually work. Replace with a real
# Clerk project's keys (https://dashboard.clerk.com) to use the admin area.
# The publishable key must base64-decode to a host ending in "$" or the SDK
# rejects it; this dummy decodes to "clerk.example.com$".
# Public key used by the browser SDK
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
# Secret key used by the server (middleware, server components)
CLERK_SECRET_KEY=sk_test_clerkdummysecretkeyfordevbuildonly00

# Local dev default — matches docker/docker-compose.dev.yml. Read raw via
# process.env by the Prisma pg driver adapter (NOT through src/env.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/auraconnect