# ─────────────────────────────────────────────────────────────────────────────
# LAYERED ENV — 3 files, copied from these .example templates (real .env* are
# git-ignored). They STACK, they are not alternatives:
#
#   .env          shared base   — port map + Postgres creds. Docker Compose
#                                 auto-loads it, and it underlays both groups.
#   .env.current  current group — clients/current/* (admin, captive, monitor)
#   .env.legacy   legacy group  — legacy monolith + DATABASE_URL
#
# Load order per client: `dotenv -e .env.<group> -e .env` → the GROUP file wins on
# conflicts, root .env fills the gaps. Rationale: ADR 0004.
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE (.env): the shared base. Copy to `.env`. Compose reads it directly;
# both groups layer on top of it. Keep only things shared by infra + both groups.

# ── Central port map (host ports; see docs slice 2026-07-01--02) ──────────────
POSTGRES_HOST_PORT=5442
PGADMIN_HOST_PORT=5050
SEQ_HOST_PORT=5342
API_HOST_PORT=5299
# Client dev servers (host, via concurrently)
ADMIN_PORT=3301
CAPTIVE_PORTAL_PORT=3302
MONITOR_PORT=3303
LEGACY_PORT=3401
# AAA-emulation lane (opt-in `aaa` profile; slice 2026-07-03--01)
RADIUSDESK_HOST_PORT=5480
MIKROTIK_HOST_PORT=5481
RADIUS_DB_HOST_PORT=5482
MIKROTIK_LOGIN_HOST_PORT=5483

# ── AAA emulation: FreeRADIUS accounting DB (MariaDB, profile `aaa`) ───────────
# The API reads this over the MySQL wire. Creds below are dev-only; the API is
# pointed at them by config seeding (a later increment of the AAA slice).
RADIUS_DB_ROOT_PASSWORD=radius_root_pw
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=radius_pw

# ── AAA emulation: RadiusDesk rd_cake stub (Fastify HTTP, profile `aaa`) ──────
# Token the stub accepts. Point the captive portal's RADIUSDESK_TOKEN + the API's
# per-site RadiusConfig.RadiusDeskApiToken at this, base URL at localhost:5480 (host)
# / radiusdesk:8080 (in-network).
RADIUSDESK_STUB_TOKEN=dev-radiusdesk-token

# ── AAA emulation: MikroTik RouterOS REST stub (Fastify HTTPS, profile `aaa`) ──
# Basic-auth creds the stub accepts. Point the monitor's MIKROTIK_USER/PASS at these
# and MIKROTIK_HOST at localhost:5481 (host) / mikrotik:8443 (in-network), with
# MIKROTIK_TLS_VERIFY=false for the self-signed cert.
MIKROTIK_STUB_USER=admin
MIKROTIK_STUB_PASS=admin

# ── Postgres bootstrap (superuser + neutral bootstrap DB) ─────────────────────
# App databases (auraconnect, phs_portal) + their roles are created by dev/init/*.
POSTGRES_USER=local_dev
POSTGRES_PASSWORD=local_dev_pw
POSTGRES_DB=postgres

# ── API ──────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
