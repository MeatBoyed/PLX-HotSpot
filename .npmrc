# Supply-chain hardening (see docs/adr/ — dependency pinning policy).
# Newly installed packages are written to package.json as exact versions,
# so `npm install <pkg>` can never silently widen a range to a caret.
save-exact=true

# NOTE: we deliberately do NOT set `ignore-scripts=true`. The repo relies on a
# `postinstall: prisma generate` lifecycle script; a blanket block would break it.
# The current dependency tree was vetted and has no other install scripts.
