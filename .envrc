# direnv — activates the pinned Node version and loads local dev env on folder entry.
# Run `direnv allow` once after cloning. Contains NO secrets (only references files).

# Activate the Node version pinned in .nvmrc via nvm
use nvm $(cat .nvmrc)

# Local dev environment (gitignored; holds DATABASE_URL, Clerk keys, etc.)
dotenv_if_exists .env.local
