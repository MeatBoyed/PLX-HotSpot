# ─────────────────────────────────────────────────────────────────────────────
# LAYERED ENV — 3 files, copied from these .example templates (real .env* are
# git-ignored). They STACK, they are not alternatives:
#
#   .env          shared base   — port map + Postgres creds (Compose reads it)
#   .env.current  current group — clients/current/* (admin, captive, monitor)  ← THIS FILE
#   .env.legacy   legacy group  — legacy monolith + DATABASE_URL
#
# Load order per client: `dotenv -e .env.current -e .env` → THIS file wins on
# conflicts, root .env fills the gaps (e.g. the port map). Rationale: ADR 0004.
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE (.env.current): copy to `.env.current`. App config for the current
# clients. The captive-portal talks to the API on host port 5299; admin/monitor
# read a subset — unused keys are harmless. Shared infra config lives in .env.

###############################################
# API (ASP.NET, mapped host port)
###############################################
NEXT_PUBLIC_API_BASE_URL=http://localhost:5299

###############################################
# Core Application / Branding
###############################################
USE_SEED_DATA=true
SITE_TITLE="PluxNet Fibre HotSpot"
SITE_DESCRIPTION=PluxNet Fibre HotSpot
BRAND_NAME=PluxNet

###############################################
# Network / SSID
###############################################
NEXT_PUBLIC_SSID=my-demo-ssid
SSID=my-demo-ssid

###############################################
# MikroTik / RadiusDesk Essentials
###############################################
NEXT_PUBLIC_MIKROTIK_DEFAULT_USERNAME=click_to_connect@dev
NEXT_PUBLIC_MIKROTIK_DEFAULT_PASSWORD=click_to_connect
# AAA stubs (profile `aaa`): host clients hit the published host-port lanes.
# Captive → RadiusDesk stub C (direct rd_cake calls); browser → hotspot-login stub B.
MIKROTIK_RADIUS_DESK_BASE_URL=http://localhost:5480
MIKROTIK_REDIRECT_URL=https://pluxnet.co.za
NEXT_PUBLIC_MIKROTIK_BASE_URL=http://localhost:5483

# --- monitor telemetry (server-side MikroTik RouterOS API) ------------------
# The monitor client polls the MikroTik REST stub (A) over its published HTTPS lane
# (https://MIKROTIK_HOST/rest). TLS verify off — the stub uses a self-signed cert.
MIKROTIK_HOST=localhost:5481
MIKROTIK_USER=admin
MIKROTIK_PASS=admin
MIKROTIK_TLS_VERIFY=false

###############################################
# PayFast (Purchasing) — sandbox
###############################################
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_TEST_MSISDN=

###############################################
# Voucher / RadiusDesk API (server)
###############################################
VOUCHER_DEFAULT_TTL_HOURS=24
# RadiusDesk stub C token + ids (match dev/seed/captive-site.sql + the stub fixtures).
RADIUSDESK_TOKEN=dev-radiusdesk-token
RADIUSDESK_REALM_ID=1
RADIUSDESK_PROFILE_ID=102
RADIUSDESK_CLOUD_ID=1

###############################################
# SMS Services (stub unless set)
###############################################
SMS_API_URL=
SMS_API_KEY=
# EC1_SMS_API_URL is url-validated — leave UNSET, not empty (see .env.legacy.example).
# EC1_SMS_API_URL=https://notification-engine.ec1.co.za
EC1_SMS_USER_ID=
EC1_SMS_PASSWORD=

###############################################
# Analytics / Auth
###############################################
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
